{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "dialog:default",
    "opener:default",
    "opener:allow-open-path",
    "allow-load-day",
    "allow-save-day",
    "allow-load-later",
    "allow-save-later",
    "allow-carry-unfinished",
    "allow-list-categories",
    "allow-list-notes",
    "allow-read-note",
    "allow-save-note",
    "allow-delete-note",
    "allow-create-category",
    "allow-delete-category",
    "allow-rename-category",
    "allow-data-directory",
    "allow-import-file",
    "allow-absolute-path",
    "allow-open-stored-file",
    "allow-reveal-stored-file",
    "allow-open-data-directory",
    "allow-open-category-directory",
    "allow-write-export"
  ]
}
